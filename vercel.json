{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/coach",
      "destination": "/api/coach.js"
    },
    {
      "source": "/api/coach/chat",
      "destination": "/api/coach.js"
    },
    {
      "source": "/:path((?!api)[^.]*)",
      "destination": "/index.html"
    }
  ]
}